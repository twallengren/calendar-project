#!/bin/bash
# Pre-commit hook.
#
# 1. Ensures staged Java files are formatted (spotlessApply).
# 2. When any staged file is under calendars/, modules/, chronologies/, or sources/,
#    validates every calendar and aborts the commit on failure, so a bad holiday
#    definition or a broken citation never gets committed.
#
# Note: spotlessApply runs on the entire tools module, which may reformat unstaged
# files in your working tree. Only the originally staged files are re-added to the
# commit.

# Get the list of staged Java files
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$')

if [ -n "$STAGED_JAVA_FILES" ]; then
    echo "Running spotlessApply (formats all Java files in tools module)..."

    # Run spotlessApply on the entire module
    ./gradlew :tools:spotlessApply --quiet

    if [ $? -ne 0 ]; then
        echo "spotlessApply failed. Please fix formatting issues."
        exit 1
    fi

    # Re-add only the originally staged files
    for file in $STAGED_JAVA_FILES; do
        if [ -f "$file" ]; then
            git add "$file"
        fi
    done

    echo "Formatting applied. Note: unstaged files may also have been reformatted."
fi

# Get the list of staged data files (calendar specs, modules, chronologies, sources)
STAGED_DATA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(calendars|modules|chronologies|sources)/')

if [ -n "$STAGED_DATA_FILES" ]; then
    echo "Staged changes under calendars/, modules/, chronologies/, or sources/;"
    echo "running validate --all --strict..."

    ./gradlew :tools:installDist --quiet

    if [ $? -ne 0 ]; then
        echo "Build failed (installDist). Fix the build before committing."
        exit 1
    fi

    tools/build/install/tools/bin/tools validate --all --strict

    if [ $? -ne 0 ]; then
        echo "validate --all --strict failed. Fix the calendar data before committing."
        exit 1
    fi

    echo "Calendar validation passed."
fi

exit 0
