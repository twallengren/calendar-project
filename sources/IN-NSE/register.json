      "id": "nse-holiday-lists",
      "title": "NSE Capital Market Segment circulars 'Trading holidays for the calendar year' 2010-2026, the live holiday list, and archived copies of the exchange's holiday page",
      "publisher": "National Stock Exchange of India Limited",
      "location": "https://www.nseindia.com/resources/exchange-communication-holidays",
      "retrieved": "2026-10-15",
      "covers": "2010-01-01 to 2026-12-31",
