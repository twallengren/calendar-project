    {
      "id": "press-xetra-outages-2012-2018",
      "title": "Contemporaneous press on the Xetra disruptions of 2012-2018",
      "publisher": "Der Tagesspiegel (9 May 2012, 31 October 2014); Traders Magazine/Bloomberg (2 November 2014); Börse Online (7 November 2017); Cash./dpa (16 March 2018); WatersTechnology (15 October 2018); Börsen-Zeitung (4 December 2018)",
      "location": "https://www.tagesspiegel.de/wirtschaft/nichts-geht-mehr-2110540.html ; https://www.tagesspiegel.de/wirtschaft/aktienhandel-setzt-wegen-technischer-probleme-aus-3596224.html ; https://www.tradersmagazine.com/news/computer-failure-makes-deutsche-boerse-halt-stocks-trading-friday/ ; https://www.boerse-online.de/nachrichten/aktien/stoerung-im-xetra-system-legt-frankfurter-boersenhandel-teilweise-lahm-20280424.html ; https://www.cash-online.de/a/boersenhandel-in-frankfurt-erliegt-technischer-stoerung-417042/ ; https://waterstechnology.com/node/3920276 ; https://www.boersen-zeitung.de/kapitalmaerkte/storung-im-xetra-handel",
      "retrieved": "2026-10-14",
      "covers": "2010-01-01 to 2018-12-31",
      "notes": "Every reported disruption of the period was a delayed open or an intraday halt after which the session completed: 8 May 2012 (trading from 10:15-10:35), 5 June 2014 (10:21-10:30), 31 October 2014 (10:08 to about 11:20), 7 November 2017 (partial, normal from 15:46, DAX unaffected), 16 March 2018 (open delayed over an hour), 15 October 2018 (trading from 10:00 CET), 3 December 2018 (FIX slowdown, \"nicht eingestellt oder unterbrochen\"). The Tagesspiegel notes earlier failures in 2004, 2006 and November 2007 without dates; those years stay projected.",
      "local_files": [],
      "support_intervals": [
        {
          "scope": "UNSCHEDULED_EXCEPTIONS",
          "from": "2010-01-01",
          "to": "2018-12-31"
        }
      ]
    }
